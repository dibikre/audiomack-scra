ic\",\"status\":\"active\",\"tiktok\":\"\",\"twitter\":\"audiomackEDM\",\"type\":\"artist\",\"url\":\"\",\"url_slug\":\"audiomack-electronic\",\"verified\":\"tastemaker\",\"youtube\":\"\"},\"tracks\":[],\"url_slug\":\"piano-women\"}],\"music_count\":0,\"song_count\":0,\"album_count\":0,\"artist_count\":0,\"playlist_count\":0,\"results\":[{\"id\":24088244,\"album\":\"\",\"album_details\":{\"id\":\"24462175\",\"title\":\"Work Of Art\",\"url_slug\":\"work-of-art\",\"artist\":\"Asake\",\"uploader_name\":\"Asake\",\"uploader_url_slug\":\"asakemusic\",\"genre\":\"afrobeats\",\"patronage\":true,\"upc\":\"197342233958\"},\"artist\":\"Asake & Olamide\",\"audiomod\":\"yes\",\"duration\":\"166\",\"explicit\":\"no\",\"featuring\":\"\",\"genre\":\"afrobeats\",\"geo_restricted\":false,\"geo_premium\":\"\",\"image\":\"https:\\/\\/i.audiomack.com\\/asakemusic\\/6cc0cffcba.webp\",\"image_base\":\"https:\\/\\/i.audiomack.com\\/asakemusic\\/6cc0cffcba.webp\",\"original_release_date\":1684814400,\"premium_user_only\":\"no\",\"premium_download\":\"no\",\"preview\":\"\",\"producer\":\"Magicsticks\",\"released\":\"1684814400\",\"released_offset\":-110534988,\"stats\":{\"pageviews\":\"0\",\"plays-raw\":124147236,\"plays\":\"124M\",\"downloads-raw\":0,\"downloads\":\"0\",\"embedviews\":\"0\",\"track_dls\":\"0\",\"favorites-raw\":235241,\"favorites\":\"235K\",\"reposts-raw\":7389,\"reposts\":\"7.39K\",\"playlists-raw\":575649,\"playlists\":\"576K\",\"comments\":3491,\"cache-hit\":1},\"status\":\"complete\",\"type\":\"song\",\"title\":\"Amapiano\",\"uploaded\":\"1684856897\",\"uploader\":{\"id\":\"12058975\",\"bio\":\"Asake (born Ahmed Ololade, January 13, 1995, in Lagos) is a Nigerian singer, rapper, and songwriter. He studied Theatre and Dramatic Arts at Obafemi Awolowo University and began his career as a backup singer before gaining traction through social media freestyles. His 2020 single \\\"Lady\\\" opened the door; signing with Olamide's YBNL Nation in 2022 followed. His debut album Mr. Money with the Vibe (2022) debuted at No. 66 on the Billboard 200 and broke streaming records on release. Two more albums followed: Work of Art (2023) and Lungu Boy (2024), each debuting at No. 1 in Nigeria. He sold out London's O2 Arena in 2023 and New York's Barclays Center the same year. In February 2025, he departed YBNL and launched his own imprint, Giran Republic. His sound draws from Afrobeats, Fuji, amapiano, and Yoruba street music, delivered primarily in Yoruba and Pidgin English.\",\"created\":\"1563720008\",\"facebook\":\"https:\\/\\/www.facebook.com\\/asakemusic\\/\",\"followers_count\":9266056,\"genre\":\"afrobeats\",\"image\":\"https:\\/\\/i.audiomack.com\\/asakemusic\\/4e36c856bc.webp\",\"image_banner\":\"https:\\/\\/i.audiomack.com\\/asakemusic\\/615f682c6b.webp\",\"image_base\":\"https:\\/\\/i.audiomack.com\\/asakemusic\\/4e36c856bc.webp\",\"instagram\":\"mrmoney\",\"label\":\"\",\"linktree\":\"\",\"name\":\"Asake\",\"status\":\"active\",\"tiktok\":\"\",\"twitter\":\"asakemusik\",\"type\":\"artist\",\"url\":\"\",\"url_slug\":\"asakemusic\",\"verified\":\"yes\",\"youtube\":\"https:\\/\\/www.youtube.com\\/@ASAKEMUSIC\"},\"url_slug\":\"amapiano\",\"usertags\":\"\",\"volume_data\":\"[28,12,26,24,25,22,37,50,36,38,34,52,52,44,45,80,63,82,78,76,79,81,74,77,74,79,82,53,41,75,71,84,68,86,80,84,74,44,47,86,62,85,76,76,69,92,75,83,70,83,82,73,75,90,54,43,44,52,70,56,62,63,86,70,85,84,88,81,59,71,82,77,94,82,96,92,84,79,84,80,96,79,100,95,88,92,79,90,90,92,79,93,88,91,82,84,96,97,84,86,70,49,43,46,61,66,55,58,65,84,80,89,77,95,78,89,60,63,60,68,65,47,68,73,35,39,40,38,44,44,47,65,54,44,38,40,65,39,45,46,59,52,65,63,71,52,65,12,1,1]\"},{\"id\":102195414,\"album\":\"\",\"artist\":\"DJ PlentySongz\",\"audiomod\":\"yes\",\"duration\":\"\",\"explicit\":\"yes\",\"featuring\":\"\",\"genre\":\"dj-mix\",\"geo_restricted\":false,\"image\":\"https:\\/\\/i.audiomack.com\\/djplentysongz1\\/2516a957ea.webp\",\"image_base\":\"https:\\/\\/i.audiomack.com\\/djplentysongz1\